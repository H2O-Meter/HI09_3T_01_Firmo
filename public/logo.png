<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="2" dy="4" stdDeviation="3" flood-opacity="0.15" />
    </filter>
  </defs>
  <!-- Orange Brush Stroke Background (#FD7600) -->
  <path d="M 230 75 
           C 310 130, 420 160, 580 200 
           C 660 220, 720 250, 765 285 
           C 775 295, 750 310, 715 320 
           C 650 340, 540 370, 460 380 
           C 370 390, 270 420, 120 445 
           C 85 450, 65 440, 80 415 
           C 95 390, 105 380, 70 370 
           C 40 360, 20 340, 35 320 
           C 50 300, 70 290, 60 270 
           C 50 250, 80 240, 95 210 
           C 115 170, 170 120, 230 75 Z" 
        fill="#FD7600" />
  
  <!-- Splatter details -->
  <path d="M 590 190 C 670 205, 740 235, 755 250 C 730 255, 680 245, 610 230 Z" fill="#FD7600" />
  <path d="M 260 385 C 340 380, 430 370, 490 355 C 430 365, 330 385, 260 385 Z" fill="#FD7600" />
  <path d="M 40 330 C 25 350, 30 370, 50 365 C 65 360, 55 340, 40 330 Z" fill="#FD7600" />
  <path d="M 65 425 C 75 440, 95 445, 105 435 C 90 425, 75 415, 65 425 Z" fill="#FD7600" />

  <!-- School Name in Green (#016E01) with playful bold font -->
  <g fill="#016E01" text-anchor="middle" font-family="'Outfit', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-weight="900">
    <text x="420" y="225" font-size="82" letter-spacing="-1px" transform="rotate(-3 420 225)">Escola</text>
    <text x="415" y="315" font-size="78" letter-spacing="-1px" transform="rotate(-3 415 315)">Parque Ipiranga</text>
  </g>
</svg>
